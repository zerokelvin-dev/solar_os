{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pio run -e *)",
      "Bash(pio run)",
      "Bash(pio pkg list*)",
      "Bash(solar-test*)",
      "Bash(solar-qemu*)",
      "Bash(python3 -m unittest *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ],
    "ask": [
      "Bash(pio run * -t upload*)",
      "Bash(pio run -t upload*)",
      "Bash(esptool*)",
      "Bash(git push*)"
    ]
  }
}
